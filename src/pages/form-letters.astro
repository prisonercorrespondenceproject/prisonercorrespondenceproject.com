---
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="nv-page-title">
    <h1 class="mt-6 text-5xl">Form Letters</h1>
  </div>
  <div class="mt-6">
    <p>
      These are the letters that we send to prisoners who wish to access our
      resources or sign up to receive a pen pal. If you know someone inside who
      would like to get involved with the Prisoner Correspondence Project, we
      encourage you to provide them with a copy and get in touch with us by
      letter or email.
    </p>

    <p>
      Note that there is a separate introductory form letter for people
      imprisoned in Florida, Missouri or Texas.
    </p>

    <!-- TODO: re-add files -->
