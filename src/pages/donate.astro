---
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="nv-page-title">
    <h1 class="mt-6 text-5xl">DONATE</h1>
  </div>
  <div class="mt-6">
    <p style="text-align: center">
      Prisoner support that doesn’t frame itself in terms of recidivism rates
      can be&nbsp;a difficult thing to find funding for.&nbsp;&nbsp;Each year we
      have to&nbsp;raise about 3/4 of our annual budget through fundraisers and
      small monthly donations from&nbsp;people like you. Join the network of
      grassroots donors today and pledge to give $5, $10 or $20 a month.
    </p>

    <div
      style="
        position: relative;
        overflow: hidden;
        width: 100%;
        height: 1200px;
        padding-top: 100%;
      "
    >
      <iframe
        title="Donation form powered by Zeffy"
        style="
          position: absolute;
          border: 0;
          top: 0;
          left: 0;
          bottom: 0;
          right: 0;
          width: 100%;
          height: 100%;
        "
        src="https://www.zeffy.com/en-CA/embed/donation-form/15f6e8a7-0c03-4cac-92c8-af91c3df635e"
        allow="payment"
        allowtransparency="true"
      ></iframe>
    </div>
  </div>
</Layout>
