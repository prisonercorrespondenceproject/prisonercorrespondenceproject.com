---
import { Image } from "astro:assets";
import Link from "~/components/Link.astro";
import pcpLogo from "~/images/pcplogo.png";

// TODO: collapse menu on small screens
---

<header class="header">
  <div class="hfg_header site-header">
    <nav
      class="header--row header-main layout-full-contained nv-navbar header--row"
      data-row-id="main"
    >
      <div class="header--row-inner header-main-inner">
        <div class="container">
          <div class="row row--wrapper" data-section="hfg_header_layout_main">
            <div class="hfg-slot left">
              <div class="builder-item desktop-left">
                <div
                  class="item--inner builder-item--logo"
                  data-section="title_tagline"
                  data-item-id="logo"
                >
                  <div class="site-logo">
                    <Link
                      class="brand"
                      href="/"
                      aria-label="Prisoner Correspondence Project a solidarity project for gay, lesbian, transsexual, transgender, gendervariant, two-spirit, intersex, bisexual and queer prisoners"
                      rel="home"
                    >
                      <Image
                        src={pcpLogo}
                        priority
                        alt="Prisoner Correspondence Project"
                      />
                    </Link>
                  </div>
                </div>
              </div>
            </div>
            <div class="hfg-slot right">
              <div class="builder-item has-nav">
                <div
                  class="item--inner builder-item--primary-menu has_menu"
                  data-section="header_menu_primary"
                  data-item-id="primary-menu"
                >
                  <div class="nv-nav-wrap">
                    <div
                      role="navigation"
                      class="nav-menu-primary"
                      aria-label="Primary Menu"
                    >
                      <ul
                        id="nv-primary-navigation-main"
                        class="primary-menu-ul nav-ul menu-desktop"
                      >
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/">Home</Link>
                          </div>
                        </li>
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/about">About Us</Link>
                          </div>
                        </li>
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/getting-a-penpal">
                              Getting a Penpal
                            </Link>
                          </div>
                        </li>
                        <li class="menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children">
                          <div class="wrap">
                            <Link>
                              <span class="dd-title">Resources</span>
                            </Link>
                            <div
                              role="button"
                              aria-pressed="false"
                              aria-label="Open Submenu"
                              tabindex="0"
                              class="caret-wrap caret 4"
                              style="margin-left: 5px"
                            >
                              <span class="caret">
                                <svg
                                  fill="currentColor"
                                  aria-label="Dropdown"
                                  xmlns="http://www.w3.org/2000/svg"
                                  viewBox="0 0 448 512"
                                >
                                  <path d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"></path>
                                </svg>
                              </span>
                            </div>
                          </div>
                          <ul class="sub-menu">
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/resource-library">
                                  Resource Library
                                </Link>
                              </div>
                            </li>
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/product-category/newsletters">
                                  The Word Is Out
                                </Link>
                              </div>
                            </li>
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/form-letters">Form Letters</Link>
                              </div>
                            </li>
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/advocacy-resources-for-outside-pen-pals">
                                  Advocacy Resources For Outside Pen Pals
                                </Link>
                              </div>
                            </li>
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/writers-block">
                                  Writer’s Block
                                </Link>
                              </div>
                            </li>
                            <li class="menu-item">
                              <div class="wrap">
                                <Link href="/product-category/posters-outreach">
                                  Posters/Outreach
                                </Link>
                              </div>
                            </li>
                          </ul>
                        </li>
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/faqs">FAQs</Link>
                          </div>
                        </li>
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/contact-us">Contact Us</Link>
                          </div>
                        </li>
                        <li class="menu-item">
                          <div class="wrap">
                            <Link href="/donate">Donate</Link>
                          </div>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>
